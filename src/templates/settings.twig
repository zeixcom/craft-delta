{% import '_includes/forms.twig' as forms %}

<h2 class="first">{{ deltaKeys.generalSettings|t('craft-delta') }}</h2>

<div class="field">
    {{ forms.lightswitchField({
        label: deltaKeys.enableReviewWorkflow|t('craft-delta'),
        instructions: deltaKeys.enableReviewWorkflowInstructions|t('craft-delta'),
        id: 'enableWorkflow',
        name: 'enableWorkflow',
        on: settings.enableWorkflow,
    }) }}
</div>

<div class="field">
    {{ forms.textField({
        first: true,
        label: deltaKeys.diffContextLines|t('craft-delta'),
        instructions: deltaKeys.diffContextLinesInstructions|t('craft-delta'),
        id: 'diffContext',
        name: 'diffContext',
        value: settings.diffContext,
        type: 'number',
        min: 0,
        max: 20,
        size: 5,
        errors: settings.getErrors('diffContext'),
    }) }}
</div>

<div class="field">
    {{ forms.textField({
        label: deltaKeys.maxFieldLength|t('craft-delta'),
        instructions: deltaKeys.maxFieldLengthInstructions|t('craft-delta'),
        id: 'maxFieldLength',
        name: 'maxFieldLength',
        value: settings.maxFieldLength,
        type: 'number',
        min: 1000,
        size: 10,
        errors: settings.getErrors('maxFieldLength'),
    }) }}
</div>


<div class="field">
    {{ forms.lightswitchField({
        label: deltaKeys.showUnchangedFields|t('craft-delta'),
        instructions: deltaKeys.showUnchangedFieldsInstructions|t('craft-delta'),
        id: 'defaultShowUnchanged',
        name: 'defaultShowUnchanged',
        on: settings.defaultShowUnchanged,
    }) }}
</div>

<div class="field">
{{ forms.lightswitchField({
        label: deltaKeys.enableReviewMode|t('craft-delta'),
        instructions: deltaKeys.enableReviewModeInstructions|t('craft-delta'),
        id: 'enableReviewMode',
        name: 'enableReviewMode',
        on: settings.enableReviewMode,
    }) }}
</div>

<div class="field">
    {{ forms.lightswitchField({
        label: deltaKeys.enablePreview|t('craft-delta'),
        instructions: deltaKeys.enablePreviewInstructions|t('craft-delta'),
        id: 'enablePreview',
        name: 'enablePreview',
        on: settings.enablePreview,
    }) }}
</div>
