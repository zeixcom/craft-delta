{% extends "_layouts/cp" %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
{% do view.registerAssetBundle('zeixcom\\craftdelta\\assets\\diff\\DiffAsset') %}

{% set title = deltaKeys.workflowReviewsTitle|t('craft-delta') %}

{% block sidebar %}
    <nav aria-label="{{ title }}">
        <ul>
            {% for b in buckets %}
                {% set selected = b.key == selectedBucket %}
                <li>
                    <a class="{% if selected %}sel{% elseif b.count %}has-badge{% endif %}" href="{{ cpUrl('delta-reviews', { bucket: b.key }) }}">
                        <span class="label">{{ b.label }}</span>
                        {% if not selected and b.count %}
                            <span class="badge" aria-hidden="true">{{ b.count }}</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endblock %}

{% block content %}
    <div id="delta-reviews-table"></div>
{% endblock %}

{% js %}
(() => {
    const bucket = {{ selectedBucket|json_encode|raw }};

    const columns = [
        { name: '__slot:title', title: {{ deltaKeys.workflowColEntry|t('craft-delta')|json_encode|raw }}, sortField: true },
        { name: 'statusCell', title: {{ deltaKeys.workflowColStatus|t('craft-delta')|json_encode|raw }}, sortField: true, callback: (v) => v },
        { name: 'round', title: {{ deltaKeys.workflowColRound|t('craft-delta')|json_encode|raw }}, sortField: true },
        { name: 'reviewers', title: {{ deltaKeys.workflowReviewers|t('craft-delta')|json_encode|raw }}, callback: (v) => v },
    ];

    new Craft.VueAdminTable({
        columns,
        container: '#delta-reviews-table',
        fullPane: false,
        tableDataEndpoint: 'craft-delta/workflow/table-data',
        search: true,
        emptyMessage: {{ deltaKeys.workflowNoReviews|t('craft-delta')|json_encode|raw }},
        onQueryParams: (params) => {
            params.bucket = bucket;
            return params;
        },
    });
})();
{% endjs %}
