{# Diff result — rendered inside the slideout / delta-compare result container.
   Diff-only: the review workflow (verdict, comments, accept/reject) now lives on
   the dedicated /admin/delta-review page. When the draft under view has a review,
   a slim banner links there. #}

{% set stats = result.getStats() %}

<div class="delta-stats" data-stats>
    <span>
        {%- if stats.fieldsChanged == 1 -%}
            {{ deltaKeys.oneFieldChanged|t('craft-delta') }}
        {%- else -%}
            {{ deltaKeys.countFieldsChanged|t('craft-delta', { count: stats.fieldsChanged }) }}
        {%- endif -%}
    </span>
    {% if stats.additions > 0 %}
        <span class="delta-stat-added">+{{ stats.additions }}</span>
    {% endif %}
    {% if stats.deletions > 0 %}
        <span class="delta-stat-removed">&minus;{{ stats.deletions }}</span>
    {% endif %}
</div>

{% if workflow is defined and workflow %}
    <div class="delta-review-link-banner">
        <span class="delta-review-link-status">
            <span class="status {{ workflow.statusColor() }}"></span>
            {{ workflow.statusLabel() }}
        </span>
        <span class="delta-review-link-meta">
            {{ deltaKeys.workflowRound|t('craft-delta', { round: workflow.round }) }}
            {% for r in workflow.reviewers %}
                <span class="delta-reviewer-pill delta-reviewer-pill--{{ r.verdict }}">{{ r.userName ?? ('#' ~ r.userId) }}</span>
            {% endfor %}
        </span>
        <a class="btn small delta-review-link-open" href="{{ cpUrl('delta-review', { reviewId: workflow.id }) }}">
            {{ deltaKeys.workflowOpenReview|t('craft-delta') }} &nearr;
        </a>
    </div>
{% endif %}

{% include 'craft-delta/_diff-fields' with { result: result, reviewMode: false } %}
