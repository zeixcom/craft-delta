{# Diff result — rendered inside the toolbar's result container #}

{% set stats = result.getStats() %}

<div class="delta-stats" data-stats>
    <span>
        {%- if stats.fieldsChanged == 1 -%}
            {{ '1 field changed'|t('craft-delta') }}
        {%- else -%}
            {{ '{count} fields changed'|t('craft-delta', { count: stats.fieldsChanged }) }}
        {%- endif -%}
    </span>
    {% if stats.additions > 0 %}
        <span class="delta-stat-added">+{{ stats.additions }}</span>
    {% endif %}
    {% if stats.deletions > 0 %}
        <span class="delta-stat-removed">&minus;{{ stats.deletions }}</span>
    {% endif %}
</div>

{% if reviewMode is defined and reviewMode %}
    <div class="delta-review-toolbar"
         data-review-toolbar
         data-entry-id="{{ entryId }}"
         data-site-id="{{ siteId }}"
         data-source-ref="{{ sourceRef }}">
        <button type="button" class="btn delta-review-start" data-action="start-review">
            {{ 'Start Review'|t('craft-delta') }}
        </button>
    </div>

    <div class="delta-review-stepper" data-review-stepper hidden>
        <span class="delta-review-progress" data-review-progress>
            {{ '{decided} of {total} decided'|t('craft-delta', { decided: 0, total: 0 }) }}
        </span>
        <button type="button" class="btn" data-action="prev-change">
            ← {{ 'Prev'|t('craft-delta') }}
        </button>
        <button type="button" class="btn" data-action="next-change">
            {{ 'Next'|t('craft-delta') }} →
        </button>
        <button type="button" class="btn submit" data-action="apply" disabled>
            {{ 'Apply {count} accepted'|t('craft-delta', { count: 0 }) }}
        </button>
        <button type="button" class="btn delta-review-cancel" data-action="cancel-review">
            {{ 'Cancel review'|t('craft-delta') }}
        </button>
    </div>

    <div class="delta-review-banner" data-review-banner hidden></div>
{% endif %}

{% if result.hasChanges() %}
    {% set grouped = result.fieldDiffs|group('tabName') %}

    {% set namedTabs = [] %}
    {% for tabName, diffs in grouped %}
        {% if tabName != '' %}
            {% set namedTabs = namedTabs|merge([{ name: tabName, diffs: diffs, index: loop.index0 }]) %}
        {% endif %}
    {% endfor %}

    {% if namedTabs|length > 1 %}
        <nav class="delta-tabnav" aria-label="{{ 'Jump to section'|t('craft-delta') }}">
            {% for tab in namedTabs %}
                {% set changedCount = tab.diffs|filter(d => d.hasChanges)|length %}
                <a href="#delta-tab-{{ tab.index }}"
                   class="delta-tabnav-item{{ changedCount > 0 ? ' delta-tabnav-item-changed' : '' }}"
                   data-tab-target="delta-tab-{{ tab.index }}">
                    <span class="delta-tabnav-prefix">{{ 'Tab'|t('craft-delta') }}:</span>
                    {{ tab.name }}
                    {% if changedCount > 0 %}<span class="delta-tabnav-count">{{ changedCount }}</span>{% endif %}
                </a>
            {% endfor %}
        </nav>
    {% endif %}

    {% if grouped[''] is defined %}
        {% for diff in grouped[''] %}
            {% include 'craft-delta/_field-diff' with { diff: diff, reviewMode: reviewMode ?? false } %}
        {% endfor %}
    {% endif %}

    {% for tab in namedTabs %}
        <div class="delta-tab-group" id="delta-tab-{{ tab.index }}" data-tab="{{ tab.name }}">
            <div class="delta-tab-header">
                <span class="delta-tab-header-prefix">{{ 'Tab'|t('craft-delta') }}:</span>
                {{ tab.name }}
            </div>
            {% for diff in tab.diffs %}
                {% include 'craft-delta/_field-diff' with { diff: diff, reviewMode: reviewMode ?? false } %}
            {% endfor %}
        </div>
    {% endfor %}
{% else %}
    <div class="delta-empty">
        <p>{{ 'No changes between these revisions.'|t('craft-delta') }}</p>
    </div>
{% endif %}
